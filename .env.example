# Run python3 scripts/init_env.py first, then edit .env (never commit it).
# Public DNS hostname only, without https:// or a path.
COURSE_HOST=chat.example.edu
ACME_EMAIL=instructor@example.edu

# Copy the OpenAI-compatible API base URL and key from your CreateAI project.
# Use the API base, not the Builder web interface or /chat/completions URL.
CREATEAI_BASE_URL=https://replace-with-createai-api-base.example/v1
CREATEAI_API_KEY=REPLACE_ME
CREATEAI_MODEL=REPLACE_WITH_ENABLED_TOOL_CAPABLE_MODEL_ID

# Generated automatically by init_env.py. Keep stable across restarts.
MONGO_PASSWORD=GENERATE
JWT_SECRET=GENERATE
JWT_REFRESH_SECRET=GENERATE
CREDS_KEY=GENERATE
CREDS_IV=GENERATE

# Enable password reset ONLY after configuring and verifying email delivery.
ALLOW_PASSWORD_RESET=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENCRYPTION=starttls
EMAIL_USERNAME=
EMAIL_PASSWORD=
# A sender/domain you control and have verified with the mail provider.
EMAIL_FROM=